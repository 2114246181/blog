---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TOC from '../components/TOC.astro';

export interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const { title, description, pubDate, tags = [], headings = [] } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<BaseLayout title={title} description={description}>
  <Fragment slot="header"><Header /></Fragment>
  <Fragment slot="footer"><Footer /></Fragment>

  <ReadingProgress />

  <article class="post">
    <header class="post__header container container-narrow">
      <div class="post__meta">
        <time class="post__date" datetime={pubDate.toISOString()}>{formattedDate}</time>
        {tags.length > 0 && (
          <div class="post__tags">
            {tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        )}
      </div>
      <h1 class="post__title">{title}</h1>
      {description && <p class="post__desc">{description}</p>}
    </header>

    <div class="post__layout container">
      <div class="post__content">
        <slot />
      </div>
      {headings.length > 0 && (
        <aside class="post__sidebar">
          <TOC headings={headings} />
        </aside>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-bottom: var(--space-12);
  }

  .post__header {
    padding: var(--space-10) 0 var(--space-8);
    text-align: center;
  }

  .post__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .post__date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-tertiary);
  }

  .post__tags {
    display: flex;
    gap: var(--space-2);
  }

  .post__title {
    margin-bottom: var(--space-4);
  }

  .post__desc {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .post__layout {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: var(--space-8);
  }

  .post__content {
    max-width: var(--content-width);
    font-size: 1.02rem;
    line-height: 1.8;
  }

  .post__content h2 {
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-color);
  }

  .post__content h3 {
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .post__content p {
    margin-bottom: 1.2em;
  }

  .post__content img {
    max-width: 100%;
    border-radius: var(--radius-md);
    margin: var(--space-6) 0;
  }

  .post__content ul, .post__content ol {
    margin: var(--space-4) 0;
    padding-left: var(--space-6);
  }

  .post__content li {
    margin-bottom: var(--space-2);
  }

  .post__sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .post__sidebar {
      display: block;
    }
  }

  @media (max-width: 768px) {
    .post__layout {
      grid-template-columns: 1fr;
    }

    .post__header {
      padding: var(--space-8) 0 var(--space-6);
    }
  }
</style>
