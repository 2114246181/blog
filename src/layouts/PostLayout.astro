---
export interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
  tags?: string[];
}

const { title, description, pubDate, tags = [] } = Astro.props;
---

<article class="post-layout container container-narrow">
  <header class="post-header reveal">
    {pubDate && (
      <time class="post-date" datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
    )}
    <h1 class="post-title">{title}</h1>
    {description && <p class="post-desc">{description}</p>}
    {tags.length > 0 && (
      <div class="post-tags">
        {tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}
  </header>

  <div class="post-content" id="postContent">
    <slot />
  </div>

  <footer class="post-footer glass reveal">
    <p>感谢阅读 💡</p>
    <a href="/blog/blog/" class="post-back">← 返回文章列表</a>
  </footer>
</article>

<style>
  .post-layout {
    padding: 140px 0 var(--space-12);
    position: relative;
    z-index: 1;
  }

  .post-header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border);
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-tertiary);
    display: block;
    margin-bottom: var(--space-3);
  }

  .post-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
  }

  .post-desc {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .post-tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }

  .post-content {
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--text-primary);
  }

  .post-content h2 {
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .post-content h3 {
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .post-content p {
    margin-bottom: var(--space-5);
  }

  .post-content img {
    max-width: 100%;
    border-radius: var(--radius-lg);
    margin: var(--space-6) 0;
    border: 1px solid var(--border);
  }

  .post-content ul, .post-content ol {
    margin: var(--space-4) 0;
    padding-left: var(--space-6);
  }

  .post-content li {
    margin-bottom: var(--space-2);
  }

  .post-content a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-content a:hover { color: var(--accent-glow); }

  .post-footer {
    margin-top: var(--space-12);
    padding: var(--space-6) var(--space-8);
    border-radius: var(--radius-xl);
    text-align: center;
  }

  .post-footer p {
    font-size: 1.1rem;
    margin-bottom: var(--space-4);
    color: var(--text-secondary);
  }

  .post-back {
    color: var(--text-tertiary);
    text-decoration: none;
    font-size: 0.9rem;
    font-family: var(--font-display);
    transition: color var(--transition-fast);
  }

  .post-back:hover { color: var(--accent); }

  @media (max-width: 768px) {
    .post-layout { padding-top: 100px; }
    .post-footer { padding: var(--space-5); }
  }
</style>
