---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = '理想 ⚡ — 一个理想主义者的技术实践' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />

    <title>{title} — 理想 ⚡</title>

    <link rel="icon" type="image/svg+xml" href="/blog/favicon.svg" />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;family=JetBrains+Mono:wght@400;500;700&amp;display=swap" rel="stylesheet" />
    <!-- GSAP -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/TextPlugin.min.js" defer></script>
  </head>
  <body>
    <div class="ambient-bg">
      <div class="ambient-orb ambient-orb--ember" id="orbEmber"></div>
      <div class="ambient-orb ambient-orb--tide" id="orbTide"></div>
      <div class="ambient-orb ambient-orb--flare"></div>
      <div class="ambient-grid"></div>
    </div>

    <slot name="header" />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />

    <!-- GSAP Init -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const waitForGSAP = setInterval(() => {
          if (typeof gsap !== 'undefined') {
            clearInterval(waitForGSAP);
            gsap.registerPlugin(ScrollTrigger, TextPlugin);

            gsap.to('#orbEmber', {
              x: () => Math.random() * 60 - 30,
              y: () => Math.random() * 60 - 30,
              duration: 8 + Math.random() * 4,
              repeat: -1,
              yoyo: true,
              ease: 'sine.inOut',
            });

            gsap.to('#orbTide', {
              x: () => Math.random() * 60 - 30,
              y: () => Math.random() * 60 - 30,
              duration: 10 + Math.random() * 4,
              repeat: -1,
              yoyo: true,
              ease: 'sine.inOut',
            });

            gsap.utils.toArray('.reveal').forEach((el) => {
              gsap.from(el, {
                y: 40,
                opacity: 0,
                duration: 0.8,
                ease: 'power3.out',
                scrollTrigger: {
                  trigger: el,
                  start: 'top 80%',
                  toggleActions: 'play none none none',
                },
              });
            });

            gsap.utils.toArray('.reveal-scale').forEach((el) => {
              gsap.from(el, {
                scale: 0.92,
                opacity: 0,
                duration: 0.7,
                ease: 'back.out(1.4)',
                scrollTrigger: {
                  trigger: el,
                  start: 'top 80%',
                  toggleActions: 'play none none none',
                },
              });
            });
          }
        }, 100);
      });
    </script>
  </body>
</html>
