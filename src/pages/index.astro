---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featured = posts.filter(p => p.data.featured);
const recent = posts.slice(0, 6);
---

<BaseLayout title="首页">
  <Fragment slot="header"><Header /></Fragment>
  <Fragment slot="footer"><Footer /></Fragment>

  <!-- ═══ HERO ═══ -->
  <section class="hero" id="hero">
    <div class="hero__inner container">
      <div class="hero__left">
        <div class="hero__monogram" id="heroMono">理想</div>
        <div class="hero__bolt-wrap" id="heroBoltWrap">
          <span class="hero__bolt">⚡</span>
          <span class="hero__bolt-ring"></span>
        </div>
      </div>
      <div class="hero__right" id="heroRight">
        <p class="hero__pretitle">理想的自留地</p>
        <h1 class="hero__title" id="heroTitle">
          构建<span class="hero__highlight">理想</span>
        </h1>
        <p class="hero__typewriter" id="heroTypewriter">
          <span class="hero__cursor">|</span>
        </p>
        <div class="hero__actions" id="heroActions">
          <a href="/blog/blog/" class="btn btn--primary">
            浏览文章
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/blog/about/" class="btn btn--ghost">关于我</a>
        </div>
      </div>
    </div>
    <div class="hero__scroll" id="heroScroll">
      <span>向下探索</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
    </div>
  </section>

  <!-- ═══ LATEST POSTS ═══ -->
  <section class="section container" id="postsSection">
    <div class="section__header reveal">
      <h2 class="section__title">最新文章</h2>
      <p class="section__desc">用文字沉淀思考，用技术创造价值</p>
    </div>

    {recent.length === 0 ? (
      <div class="section__empty reveal">
        <p>还没有文章，敬请期待</p>
      </div>
    ) : (
      <div class="post-grid">
        {recent.slice(0, 1).map(p => (
          <div class="post-grid__featured reveal-scale" key={p.id}>
            <BlogCard
              title={p.data.title}
              description={p.data.description}
              pubDate={p.data.pubDate}
              tags={p.data.tags}
              slug={p.id.replace(/\.\w+$/, '')}
              featured={p.data.featured}
              index={0}
            />
          </div>
        ))}
        {recent.slice(1).map((p, i) => (
          <div class="post-grid__item reveal" key={p.id} style={`transition-delay: ${i * 0.05}s`}>
            <BlogCard
              title={p.data.title}
              description={p.data.description}
              pubDate={p.data.pubDate}
              tags={p.data.tags}
              slug={p.id.replace(/\.\w+$/, '')}
              featured={false}
              index={i + 1}
            />
          </div>
        ))}
      </div>
    )}

    {recent.length > 0 && (
      <div class="section__cta reveal" style="text-align:center;margin-top:var(--space-8)">
        <a href="/blog/blog/" class="btn btn--ghost">查看全部文章 →</a>
      </div>
    )}
  </section>

  <!-- ═══ ABOUT SNIPPET ═══ -->
  <section class="about-snip section container" id="aboutSection">
    <div class="about-snip__card glass reveal-scale">
      <div class="about-snip__content">
        <div class="about-snip__icon">⚡</div>
        <h2 class="about-snip__title">你好，我是<span class="ember-text">理想</span></h2>
        <p class="about-snip__text">
          一个理想主义者的技术实践。写代码，也写生活。相信好的技术能改变世界，也相信好的文字能温暖人心。
        </p>
        <a href="/blog/about/" class="btn btn--primary btn--sm">
          了解更多
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ═══════════════════════════════════════ HERO ═══ */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    z-index: 1;
    padding-top: 80px;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    align-items: center;
    flex: 1;
  }

  .hero__left {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .hero__monogram {
    font-family: var(--font-display);
    font-size: clamp(5rem, 14vw, 12rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 1;
    background: var(--color-ember-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    opacity: 0;
    transform: scale(0.8);
    position: relative;
    z-index: 2;
  }

  .hero__bolt-wrap {
    position: absolute;
    z-index: 1;
  }

  .hero__bolt {
    font-size: 3rem;
    position: absolute;
    top: -60px;
    right: -40px;
    animation: bolt-glow 3s ease-in-out infinite;
  }

  .hero__bolt-ring {
    position: absolute;
    width: 120px;
    height: 120px;
    top: -80px;
    right: -60px;
    border-radius: 50%;
    border: 1px solid var(--color-ember);
    opacity: 0.2;
    animation: ring-pulse 4s ease-in-out infinite;
  }

  @keyframes bolt-glow {
    0%, 100% { opacity: 0.6; filter: drop-shadow(0 0 4px var(--color-ember)); }
    50% { opacity: 1; filter: drop-shadow(0 0 16px var(--color-ember)); }
  }

  @keyframes ring-pulse {
    0%, 100% { transform: scale(1); opacity: 0.2; }
    50% { transform: scale(1.3); opacity: 0.05; }
  }

  .hero__right {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hero__pretitle {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-tertiary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__title {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .hero__highlight {
    background: var(--color-ember-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 800;
  }

  .hero__typewriter {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--text-secondary);
    line-height: 1.6;
    min-height: 1.8em;
    font-family: var(--font-body);
  }

  .hero__cursor {
    display: inline-block;
    color: var(--color-ember);
    animation: blink 1s step-end infinite;
    font-weight: 100;
  }

  @keyframes blink { 50% { opacity: 0; } }

  .hero__actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 12px 28px;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--transition-base);
    cursor: pointer;
    border: none;
  }

  .btn--primary {
    background: var(--color-ember-gradient);
    color: var(--text-inverse);
  }
  .btn--primary:hover { transform: translateY(-2px); box-shadow: var(--shadow-ember); color: var(--text-inverse); }

  .btn--ghost {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }
  .btn--ghost:hover {
    border-color: var(--color-ember);
    color: var(--color-ember);
    background: var(--color-ember-soft);
  }

  .btn--sm { padding: 10px 22px; font-size: 0.84rem; }

  .hero__scroll {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding-bottom: var(--space-8);
    color: var(--text-tertiary);
    font-size: 0.78rem;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    animation: float-down 2.5s ease-in-out infinite;
  }

  @keyframes float-down {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(8px); opacity: 1; }
  }

  /* ═══ Sections ═══ */
  .section { padding: var(--space-16) 0; position: relative; z-index: 1; }
  .section__header { margin-bottom: var(--space-8); }
  .section__title { margin-bottom: var(--space-2); }

  .section__title::after {
    content: '';
    display: block;
    width: 48px;
    height: 3px;
    background: var(--color-ember-gradient);
    border-radius: 2px;
    margin-top: var(--space-3);
  }

  .section__desc { color: var(--text-secondary); font-size: 1.05rem; margin-top: var(--space-2); }

  .section__empty {
    text-align: center;
    padding: var(--space-10);
    color: var(--text-tertiary);
    border: 1px dashed var(--border-color);
    border-radius: var(--radius-lg);
    font-style: italic;
  }

  /* ═══ Post Grid ═══ */
  .post-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  .post-grid__featured { grid-column: 1 / -1; }

  /* ═══ About Snippet ═══ */
  .about-snip { padding: var(--space-12) 0 var(--space-16); position: relative; z-index: 1; }

  .about-snip__card {
    max-width: 600px;
    margin: 0 auto;
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    text-align: center;
  }

  .about-snip__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .about-snip__icon { font-size: 3rem; animation: bolt-glow 3s ease-in-out infinite; }
  .about-snip__title { font-family: var(--font-display); font-size: 1.8rem; font-weight: 700; }
  .about-snip__text { color: var(--text-secondary); line-height: 1.7; max-width: 420px; font-size: 0.95rem; }

  /* ═══ Responsive ═══ */
  @media (max-width: 768px) {
    .hero__inner { grid-template-columns: 1fr; gap: var(--space-4); text-align: center; }
    .hero__monogram { font-size: clamp(4rem, 20vw, 8rem); }
    .hero__bolt { display: none; }
    .hero__bolt-ring { display: none; }
    .hero__right { align-items: center; }
    .hero__actions { justify-content: center; }
    .post-grid { grid-template-columns: 1fr; }
    .about-snip__card { padding: var(--space-6); }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    tl.from('#heroMono', { scale: 0.6, opacity: 0, duration: 1.2, ease: 'elastic.out(1, 0.5)' })
      .from('#heroBoltWrap', { scale: 0, opacity: 0, duration: 0.6, ease: 'back.out(2)' }, '-=0.4')
      .from('#heroRight', { y: 40, opacity: 0, duration: 0.8 }, '-=0.6')
      .from('#heroActions', { y: 20, opacity: 0, duration: 0.5 }, '-=0.3')
      .from('#heroScroll', { y: 10, opacity: 0, duration: 0.5 }, '-=0.2');

    // Typewriter
    const phrases = [
      '在代码与生活之间，寻找更好的答案',
      '写有温度的代码，做有态度的人',
      '技术 · 创造 · 生活 · 理想',
      '一个理想主义者的技术实践',
    ];

    let phraseIndex = 0, charIndex = 0, isDeleting = false;
    const twEl = document.querySelector('.hero__typewriter');

    if (twEl) {
      function typeEffect() {
        const current = phrases[phraseIndex];
        if (!isDeleting) {
          charIndex++;
          twEl.innerHTML = current.substring(0, charIndex) + '<span class="hero__cursor">|</span>';
          if (charIndex === current.length) { isDeleting = true; setTimeout(typeEffect, 2000); return; }
          setTimeout(typeEffect, 50 + Math.random() * 40);
        } else {
          charIndex--;
          twEl.innerHTML = current.substring(0, charIndex) + '<span class="hero__cursor">|</span>';
          if (charIndex === 0) { isDeleting = false; phraseIndex = (phraseIndex + 1) % phrases.length; setTimeout(typeEffect, 300); return; }
          setTimeout(typeEffect, 20 + Math.random() * 20);
        }
      }
      setTimeout(typeEffect, 1200);
    }

    // Card tilt
    document.querySelectorAll('.card').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left, y = e.clientY - rect.top;
        const cx = rect.width / 2, cy = rect.height / 2;
        card.style.transform = `perspective(800px) rotateX(${(y-cy)/cy*-6}deg) rotateY(${(x-cx)/cx*6}deg) translateY(-3px)`;
      });
      card.addEventListener('mouseleave', () => { card.style.transform = ''; });
    });

    // Scroll reveals
    gsap.utils.toArray('.post-grid__item').forEach((el, i) => {
      gsap.from(el, { y: 40, opacity: 0, duration: 0.6, delay: i * 0.08, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none none' } });
    });
    gsap.utils.toArray('.post-grid__featured').forEach((el) => {
      gsap.from(el, { y: 30, opacity: 0, duration: 0.8, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none none' } });
    });
  });
</script>
