---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const recent = posts.slice(0, 6);
---

<BaseLayout title="首页">
  <Fragment slot="header"><Header /></Fragment>
  <Fragment slot="footer"><Footer /></Fragment>

  <!-- ═══ HERO ═══ -->
  <section class="hero" id="hero">
    <div class="hero__inner container">
      <div class="hero__monogram-wrap">
        <h1 class="hero__monogram">理想</h1>
        <span class="hero__bolt">⚡</span>
      </div>
      <div class="hero__right">
        <p class="hero__subtitle">理想的自留地</p>
        <p class="hero__typewriter" id="typewriter"></p>
        <div class="hero__actions">
          <a href="/blog/blog/" class="btn btn--primary">
            浏览文章
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/blog/about/" class="btn btn--ghost">关于</a>
        </div>
      </div>
    </div>
    <div class="hero__scroll">
      <span>向下探索</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
    </div>
  </section>

  <!-- ═══ LATEST POSTS ═══ -->
  <section class="section container" id="postsSection">
    <header class="section__header reveal">
      <h2 class="section__title">最新文章</h2>
      <p class="section__desc">用文字沉淀思考，用技术创造价值</p>
    </header>

    {recent.length === 0 ? (
      <div class="section__empty reveal">
        <p>还没有文章，敬请期待</p>
      </div>
    ) : (
      <div class="post-grid">
        {recent.map((p, i) => (
          <div class="post-grid__item reveal" key={p.id} style={`transition-delay: ${i * 0.06}s`}>
            <BlogCard
              title={p.data.title}
              description={p.data.description}
              pubDate={p.data.pubDate}
              tags={p.data.tags}
              slug={p.id.replace(/\.\w+$/, '')}
              index={i}
            />
          </div>
        ))}
      </div>
    )}

    {recent.length > 0 && (
      <div class="section__footer reveal">
        <a href="/blog/blog/" class="btn btn--ghost">查看全部文章 →</a>
      </div>
    )}
  </section>

  <!-- ═══ ABOUT ═══ -->
  <section class="about-section container reveal">
    <div class="about-section__card glass">
      <span class="about-section__icon">⚡</span>
      <h2 class="about-section__title">你好，我是 <span class="accent-text">理想</span></h2>
      <p class="about-section__text">一个理想主义者的技术实践。写代码，也写生活。</p>
      <a href="/blog/about/" class="btn btn--primary btn--sm">
        了解更多
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ═══ Hero ═══ */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    z-index: 1;
    padding-top: 80px;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-10);
    align-items: center;
    flex: 1;
  }

  .hero__monogram-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero__monogram {
    font-family: var(--font-display);
    font-size: clamp(6rem, 16vw, 14rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.06em;
    color: var(--text-primary);
    position: relative;
    z-index: 2;
  }

  .hero__bolt {
    position: absolute;
    top: -10%;
    right: -15%;
    font-size: 3rem;
    z-index: 3;
    animation: hero-bolt 3s ease-in-out infinite;
    filter: drop-shadow(0 0 8px var(--accent));
  }

  @keyframes hero-bolt {
    0%, 100% { opacity: 0.6; transform: scale(1) rotate(0deg); }
    50% { opacity: 1; transform: scale(1.15) rotate(10deg); filter: drop-shadow(0 0 20px var(--accent)); }
  }

  .hero__right {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 440px;
  }

  .hero__subtitle {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-tertiary);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
  }

  .hero__typewriter {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: var(--text-secondary);
    line-height: 1.7;
    min-height: 2em;
    font-family: var(--font-body);
    border-right: 2px solid var(--accent);
    width: fit-content;
    padding-right: 4px;
    animation: blink-cursor 0.8s step-end infinite;
    margin: 0;
  }

  @keyframes blink-cursor { 50% { border-color: transparent; } }

  .hero__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .hero__scroll {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding-bottom: var(--space-6);
    color: var(--text-tertiary);
    font-size: 0.75rem;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    animation: hero-float 2.5s ease-in-out infinite;
  }

  @keyframes hero-float {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50% { transform: translateY(6px); opacity: 1; }
  }

  /* ═══ Sections ═══ */
  .section {
    padding: var(--space-12) 0;
    position: relative;
    z-index: 1;
  }

  .section__header { margin-bottom: var(--space-8); }

  .section__title {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .section__title::after {
    content: '';
    display: block;
    width: 36px;
    height: 3px;
    background: var(--accent);
    border-radius: 2px;
    margin-top: var(--space-2);
  }

  .section__desc { color: var(--text-secondary); font-size: 0.95rem; }

  .section__empty {
    text-align: center;
    padding: var(--space-10);
    color: var(--text-tertiary);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    font-style: italic;
  }

  .section__footer {
    text-align: center;
    margin-top: var(--space-8);
  }

  /* ═══ Post Grid ═══ */
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-5);
  }

  /* ═══ About ═══ */
  .about-section { padding-bottom: var(--space-12); position: relative; z-index: 1; }

  .about-section__card {
    max-width: 520px;
    margin: 0 auto;
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    text-align: center;
  }

  .about-section__icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: var(--space-4);
    animation: hero-bolt 3s ease-in-out infinite;
  }

  .about-section__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .about-section__text {
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 380px;
    margin: 0 auto var(--space-5);
    font-size: 0.92rem;
  }

  /* ═══ Responsive ═══ */
  @media (max-width: 768px) {
    .hero__inner { grid-template-columns: 1fr; gap: var(--space-4); text-align: center; }
    .hero__monogram { font-size: clamp(5rem, 20vw, 8rem); }
    .hero__bolt { font-size: 2rem; top: -5%; right: -5%; }
    .hero__right { align-items: center; max-width: 100%; }
    .hero__typewriter { text-align: center; margin: 0 auto; }
    .hero__actions { justify-content: center; }
    .post-grid { grid-template-columns: 1fr; }
    .about-section__card { padding: var(--space-6); }
  }
</style>

<script>
  // Typewriter effect (vanilla JS, no GSAP dependency)
  document.addEventListener('DOMContentLoaded', () => {
    const el = document.getElementById('typewriter');
    if (!el) return;

    const phrases = [
      '在代码与生活之间，寻找更好的答案',
      '写有温度的代码，做有态度的人',
      '技术 · 创造 · 生活 · 理想',
      '一个理想主义者的技术实践',
    ];

    let phraseIdx = 0, charIdx = 0, deleting = false;

    function type() {
      const current = phrases[phraseIdx];
      if (!deleting) {
        charIdx++;
        el.textContent = current.substring(0, charIdx);
        if (charIdx === current.length) {
          deleting = true;
          setTimeout(type, 2000);
          return;
        }
        setTimeout(type, 50 + Math.random() * 40);
      } else {
        charIdx--;
        el.textContent = current.substring(0, charIdx);
        if (charIdx === 0) {
          deleting = false;
          phraseIdx = (phraseIdx + 1) % phrases.length;
          setTimeout(type, 300);
          return;
        }
        setTimeout(type, 20 + Math.random() * 20);
      }
    }

    // Add hero animation class after 100ms for CSS entrance
    setTimeout(() => document.getElementById('hero')?.classList.add('hero-ready'), 100);
    setTimeout(type, 800);
  });
</script>
