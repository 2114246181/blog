---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const allTags = [...new Set(posts.flatMap(p => p.data.tags || []))].sort();
---

<BaseLayout title="文章">
  <Fragment slot="header"><Header /></Fragment>
  <Fragment slot="footer"><Footer /></Fragment>

  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title reveal">文章</h1>
      <p class="page-hero__desc reveal">共 {posts.length} 篇</p>
    </div>
  </section>

  <section class="container blog-listing">
    {allTags.length > 1 && (
      <div class="tags-bar reveal" id="tagsBar">
        <button class="tag tag--active" data-tag="all">全部</button>
        {allTags.map(tag => (
          <button class="tag tag--filter" data-tag={tag}>{tag}</button>
        ))}
      </div>
    )}

    {posts.length === 0 ? (
      <div class="empty-section">
        <p>还没有文章</p>
      </div>
    ) : (
      <div class="posts-grid reveal" id="postsGrid">
        {posts.map((post, i) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            slug={post.id.replace(/\.\w+$/, '')}
            featured={post.data.featured}
            index={i}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 140px 0 var(--space-8);
    position: relative;
    z-index: 1;
  }

  .page-hero__title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
  }

  .page-hero__desc {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    margin-top: var(--space-2);
  }

  .blog-listing {
    padding-bottom: var(--space-16);
    position: relative;
    z-index: 1;
  }

  .tags-bar {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .tag {
    cursor: pointer;
  }

  .tag--active {
    background: var(--accent);
    color: var(--text-inverse);
    border-color: var(--accent);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-5);
  }

  .empty-section {
    text-align: center;
    padding: var(--space-10);
    color: var(--text-tertiary);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
  }

  @media (max-width: 768px) {
    .page-hero { padding-top: 100px; }
    .posts-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tags = document.querySelectorAll('.tag--filter, .tag--active');
    const posts = document.querySelectorAll('.card');
    const activeTag = document.querySelector('.tag--active');

    tags.forEach(tag => {
      tag.addEventListener('click', () => {
        tags.forEach(t => t.classList.remove('tag--active'));
        tag.classList.add('tag--active');

        const selected = tag.dataset.tag;

        posts.forEach(post => {
          const postTags = post.querySelector('.card__tags');
          if (!postTags) return;

          if (selected === 'all') {
            post.style.display = '';
            return;
          }

          const hasTag = [...postTags.querySelectorAll('.tag')]
            .some(t => t.textContent.trim() === selected);

          post.style.display = hasTag ? '' : 'none';
        });
      });
    });
  });
</script>
