---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到">
  <section class="error container" style="text-align:center;padding:var(--space-12)0;">
    <h1 class="gradient-text" style="font-size:4rem;">404</h1>
    <p style="color:var(--text-secondary);margin:var(--space-4)0 var(--space-8);">页面不见了</p>
    <a href="/blog/" class="btn btn--primary" style="display:inline-flex;">回首页</a>
  </section>
</BaseLayout>
