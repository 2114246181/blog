---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="关于">
  <Fragment slot="header"><Header /></Fragment>
  <Fragment slot="footer"><Footer /></Fragment>

  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title reveal">关于</h1>
      <p class="page-hero__desc reveal">理想 ⚡</p>
    </div>
  </section>

  <section class="about-section container container-narrow">
    <div class="about-card glass reveal-scale">
      <div class="about-avatar">⚡</div>
      <h2 class="about-name">理想</h2>
      <p class="about-tagline">一个理想主义者的技术实践</p>
      <p class="about-text">
        写代码，也写生活。相信好的技术能改变世界，也相信好的文字能温暖人心。
      </p>
      <p class="about-text">
        这个博客记录我对技术、生活和所有美好事物的思考。
        如果能给你带来一点启发或共鸣，那就值得了。
      </p>
    </div>

    <div class="about-tech reveal">
      <h3>技术栈</h3>
      <div class="about-tech__items">
        <span>Astro 6</span>
        <span>GSAP 3</span>
        <span>TypeScript</span>
        <span>GitHub Pages</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 140px 0 var(--space-8);
    position: relative;
    z-index: 1;
  }

  .page-hero__title { font-size: clamp(2.5rem, 5vw, 3.5rem); }

  .page-hero__desc {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    margin-top: var(--space-2);
  }

  .about-section {
    padding-bottom: var(--space-16);
    position: relative;
    z-index: 1;
  }

  .about-card {
    padding: var(--space-10);
    border-radius: var(--radius-xl);
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .about-avatar {
    font-size: 4rem;
    margin-bottom: var(--space-4);
    animation: bolt-glow 3s ease-in-out infinite;
  }

  @keyframes bolt-glow {
    0%, 100% { opacity: 0.7; filter: drop-shadow(0 0 4px var(--color-ember)); }
    50% { opacity: 1; filter: drop-shadow(0 0 16px var(--color-ember)); }
  }

  .about-name {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  .about-tagline {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: var(--space-6);
    font-style: italic;
  }

  .about-text {
    color: var(--text-secondary);
    line-height: 1.8;
    max-width: 480px;
    margin: 0 auto var(--space-3);
    font-size: 0.95rem;
  }

  .about-tech {
    text-align: center;
  }

  .about-tech h3 {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  .about-tech__items {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  .about-tech__items span {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 4px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .page-hero { padding-top: 100px; }
    .about-card { padding: var(--space-6); }
  }
</style>
