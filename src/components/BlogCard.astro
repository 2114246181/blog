---
export interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  tags: string[];
  slug: string;
  index?: number;
}

const { title, description, pubDate, tags, slug, index = 0 } = Astro.props;
---

<article class="card" data-index={index}>
  <a href={`/blog/blog/${slug}/`} class="card__link">
    <div class="card__meta">
      <time class="card__date" datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
      </time>
      {tags.length > 0 && (
        <div class="card__tags">
          {tags.slice(0, 2).map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}
    </div>
    <h2 class="card__title">{title}</h2>
    {description && <p class="card__desc">{description}</p>}
    <span class="card__read">
      阅读
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </span>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    transition: all var(--transition-base);
    position: relative;
  }

  .card:hover {
    background: var(--bg-card-hover);
    border-color: var(--accent-border);
    transform: translateY(-2px);
    box-shadow: var(--shadow-accent);
  }

  .card__link {
    display: block;
    padding: var(--space-5);
    text-decoration: none;
    color: inherit;
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .card__date {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
  }

  .card__tags { display: flex; gap: var(--space-2); flex-wrap: wrap; }

  .card__title {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    font-weight: 600;
    margin-bottom: var(--space-2);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .card__desc {
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .card__read {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-3);
    color: var(--text-tertiary);
    font-size: 0.8rem;
    font-weight: 500;
    font-family: var(--font-display);
    transition: all var(--transition-fast);
  }

  .card:hover .card__read { color: var(--accent); gap: var(--space-2); }
</style>
