---
export interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  tags: string[];
  slug: string;
  featured?: boolean;
  index?: number;
}

const { title, description, pubDate, tags, slug, featured = false, index = 0 } = Astro.props;
---

<article class={`card ${featured ? 'card--featured' : ''}`} data-index={index}>
  <a href={`/blog/blog/${slug}/`} class="card__link">
    <div class="card__meta">
      <time class="card__date" datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      {tags.length > 0 && (
        <div class="card__tags">
          {tags.slice(0, 3).map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </div>

    <h2 class="card__title">{title}</h2>

    {description && <p class="card__desc">{description}</p>}

    <div class="card__readmore">
      <span>阅读全文</span>
      <span class="card__arrow">→</span>
    </div>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    transition: all var(--transition-base);
    overflow: hidden;
    position: relative;
    will-change: transform;
  }

  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, var(--color-ember), var(--color-tide), transparent 50%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity var(--transition-base);
    pointer-events: none;
  }

  .card:hover {
    background: var(--bg-card-hover);
    border-color: transparent;
    transform: translateY(-3px);
    box-shadow: var(--shadow-ember);
  }

  .card:hover::before { opacity: 1; }

  .card--featured {
    border-color: var(--border-ember);
    background: linear-gradient(135deg, var(--bg-card), var(--color-ember-soft));
  }

  .card__link {
    display: block;
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .card__date {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
  }

  .card__tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .card__title {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    margin-bottom: var(--space-3);
    line-height: 1.35;
    font-weight: 600;
  }

  .card__desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__readmore {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    color: var(--color-ember);
    font-size: 0.85rem;
    font-weight: 500;
    transition: gap var(--transition-fast);
  }

  .card__arrow {
    transition: transform var(--transition-fast);
    display: inline-block;
  }

  .card:hover .card__readmore { gap: var(--space-3); }
  .card:hover .card__arrow { transform: translateX(4px); }
</style>
