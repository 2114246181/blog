---
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog'));
const postCount = posts.filter(p => !p.data.draft).length;
---

<header class="header" id="header">
  <nav class="header__nav container">
    <a href="/blog/" class="header__brand" aria-label="首页">
      <span class="header__logo">理想</span>
      <span class="header__logo-bolt">⚡</span>
    </a>

    <div class="header__links">
      <a href="/blog/" class="header__link">首页</a>
      <a href="/blog/blog/" class="header__link">
        文章
        <span class="header__count">{postCount}</span>
      </a>
      <a href="/blog/about/" class="header__link">关于</a>
      <button class="theme-toggle" id="themeToggle" aria-label="切换主题">
        <svg class="theme-icon theme-icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="theme-icon theme-icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: var(--space-4) 0;
    transition: all var(--transition-base);
  }

  .header--scrolled {
    background: var(--bg-glass-heavy);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-color);
    padding: var(--space-2) 0;
  }

  .header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    text-decoration: none;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: opacity var(--transition-fast);
  }

  .header__brand:hover { opacity: 0.8; color: var(--text-primary); }

  .header__logo { color: var(--color-ember); }
  .header__logo-bolt { font-size: 1rem; }

  .header__links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .header__link {
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 500;
    transition: color var(--transition-fast);
    display: flex;
    align-items: center;
    gap: var(--space-1);
    position: relative;
  }

  .header__link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-ember-gradient);
    transition: width var(--transition-base);
    border-radius: 1px;
  }

  .header__link:hover { color: var(--text-primary); }
  .header__link:hover::after { width: 100%; }

  .header__count {
    font-size: 0.7rem;
    padding: 1px 7px;
    border-radius: var(--radius-full);
    background: var(--color-ember-soft);
    color: var(--color-ember);
    font-weight: 600;
    font-family: var(--font-mono);
  }

  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    padding: var(--space-1);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
  }

  .theme-toggle:hover { color: var(--color-ember); }

  .theme-icon { display: block; }

  .light .theme-icon--sun { display: none; }
  :root:not(.light) .theme-icon--moon { display: none; }

  @media (max-width: 768px) {
    .header__links { gap: var(--space-4); }
  }
</style>

<script>
  // Scroll effect
  const header = document.getElementById('header');

  const scrollObserver = new IntersectionObserver(
    ([e]) => {
      if (!e.isIntersecting) { header.classList.add('header--scrolled'); }
      else { header.classList.remove('header--scrolled'); }
    },
    { rootMargin: '-1px 0px 0px 0px', threshold: [1] }
  );

  // Create sentinel
  const sentinel = document.createElement('div');
  sentinel.style.position = 'absolute';
  sentinel.style.top = '0';
  sentinel.style.left = '0';
  sentinel.style.width = '1px';
  sentinel.style.height = '1px';
  document.body.prepend(sentinel);
  scrollObserver.observe(sentinel);

  // Theme toggle
  const toggle = document.getElementById('themeToggle');
  toggle?.addEventListener('click', () => {
    document.documentElement.classList.toggle('light');
    const isLight = document.documentElement.classList.contains('light');
    document.documentElement.setAttribute('data-theme', isLight ? 'light' : 'dark');
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
  });

  // Restore theme
  const savedTheme = localStorage.getItem('theme');
  if (savedTheme === 'light') {
    document.documentElement.classList.add('light');
    document.documentElement.setAttribute('data-theme', 'light');
  }
</script>
