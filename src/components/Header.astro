---
const navItems = [
  { label: '首页', href: '/blog/' },
  { label: '文章', href: '/blog/blog/' },
  { label: '关于', href: '/blog/about/' },
];
---

<header class="header glass" id="header">
  <nav class="container header__nav">
    <a href="/blog/" class="header__logo">
      <span class="header__logo-icon">&lt;/&gt;</span>
      <span class="header__logo-text gradient-text">理想</span>
    </a>

    <div class="header__nav-items">
      {navItems.map(item => (
        <a href={item.href} class="header__nav-link">{item.label}</a>
      ))}
    </div>

    <button class="theme-toggle" id="themeToggle" aria-label="切换主题">
      <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="5"/>
        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
      </svg>
    </button>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 64px;
    border-bottom: 1px solid var(--border-glass);
    transition: background var(--transition-base);
  }

  .header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    font-family: var(--font-display);
  }

  .header__logo-icon {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .header__logo-text {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .header__nav-items {
    display: flex;
    gap: var(--space-6);
    align-items: center;
  }

  .header__nav-link {
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    position: relative;
    transition: color var(--transition-fast);
    padding: var(--space-1) 0;
  }

  .header__nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--accent-gradient);
    transition: width var(--transition-base);
    border-radius: 1px;
  }

  .header__nav-link:hover {
    color: var(--text-primary);
  }

  .header__nav-link:hover::after {
    width: 100%;
  }

  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    padding: var(--space-2);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .theme-toggle:hover {
    color: var(--color-primary);
    background: rgba(0, 212, 255, 0.08);
  }

  .theme-toggle__icon {
    width: 20px;
    height: 20px;
  }

  .theme-toggle__icon--sun { display: none; }
  .theme-toggle__icon--moon { display: block; }

  :global(.light) .theme-toggle__icon--sun { display: block; }
  :global(.light) .theme-toggle__icon--moon { display: none; }

  @media (max-width: 768px) {
    .header__nav-items {
      gap: var(--space-4);
    }

    .header__logo-text {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('themeToggle');
  toggle?.addEventListener('click', () => {
    const html = document.documentElement;
    const isLight = html.classList.toggle('light');
    localStorage.setItem('blog-theme', isLight ? 'light' : 'dark');
  });
</script>
